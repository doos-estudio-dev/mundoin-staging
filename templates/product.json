padding-inline-end":0},"blocks":{"custom_sucursales_Qh9LKL":{"type":"custom-sucursales","name":"Sucursales","settings":{},"blocks":{}},"custom_description_accordion":{"type":"custom-product-description-accordion","name":"Product description","settings":{},"blocks":{}},"accordion_yR9yKt":{"type":"accordion","name":"t:names.accordion","settings":{"icon":"caret","dividers":true,"type_preset":"h6","inherit_color_scheme":true,"color_scheme":"","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"accordion_row_KLpxXK":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Disponibilidad en sucursales","open_by_default":false,"icon":"none","width":20},"blocks":{"custom_liquid_NaGmcr":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"{% comment %} \n  1. ENVOLTORIO DINÁMICO: \n  El ID \"dynamic-inventory-wrapper\" es clave para que el script pueda refrescar el contenido.\n{% endcomment %}\n<div id=\"dynamic-inventory-wrapper\">\n  \n  {% comment %} 2. DEFINICIÓN DE SUCURSALES (Llaves de variante _v creadas en Shopify) {% endcomment %}\n  {% assign sucursales = \"Centro|stock_centro_v,Coyoacán|suc_coyoacan_v,Benito Juárez|suc_benito_juarez_v,Gustavo Baz|suc_gustavo_baz_v,Naucalpan|suc_naucalpan_v,Toluca|suc_toluca_v,Querétaro|suc_queretaro_v,Vallejo|suc_vallejo_v,Puebla|suc_puebla_v\" | split: \",\" %}\n\n  {% comment %} 3. DETECCIÓN DE VARIANTE SELECCIONADA {% endcomment %}\n  {% assign variant = product.selected_or_first_available_variant %}\n\n  {% comment %} 4. LÓGICA DE VISIBILIDAD: Solo muestra la tabla si hay stock en alguna sucursal {% endcomment %}\n  {% assign hay_stock = false %}\n  {% for s in sucursales %}\n    {% assign key = s | split: \"|\" | last | strip %}\n    {% assign stock = variant.metafields.custom[key] %}\n    {% if stock.value > 0 %}\n      {% assign hay_stock = true %}\n      {% break %}\n    {% endif %}\n  {% endfor %}\n\n  {% if hay_stock %}\n  <div id=\"sucursales-container\" style=\"margin: 20px 0; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);\">\n    \n    <div style=\"background: #184E56; color: white; padding: 12px 16px; font-size: 14px; font-weight: bold; display: flex; align-items: center; gap: 8px;\">\n      <i class=\"ph-bold ph-storefront\"><\/i> Disponibilidad en Sucursales: {{ variant.title }}\n    <\/div>\n    \n    <div style=\"overflow-x: auto;\">\n      <table style=\"width: 100%; border-collapse: collapse; background: white;\">\n        <thead>\n          <tr style=\"background: #f8fafc;\">\n            <th style=\"padding: 12px; text-align: left; font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;\">Sucursal<\/th>\n            <th style=\"padding: 12px; text-align: center; font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;\">Stock<\/th>\n            <th style=\"padding: 12px; text-align: right; font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;\">Ubicación<\/th>\n          <\/tr>\n        <\/thead>\n        <tbody>\n          {% for s in sucursales %}\n            {% assign pair = s | split: \"|\" %}\n            {% assign nombre = pair[0] | strip %}\n            {% assign key = pair[1] | strip %}\n            {% assign stock = variant.metafields.custom[key] %}\n            \n            {% if stock.value > 0 %}\n              <tr style=\"border-bottom: 1px solid #f1f5f9;\">\n                <td style=\"padding: 12px 16px; font-size: 14px; color: #1e293b;\"><strong>{{ nombre }}<\/strong><\/td>\n                <td style=\"padding: 12px; text-align: center;\">\n                  <span style=\"background: #f0fdf4; color: #166534; padding: 4px 12px; border-radius: 9999px; font-weight: 700; font-size: 13px; border: 1px solid #bbf7d0;\">\n                    {{ stock.value }} unidades\n                  <\/span>\n                <\/td>\n                <td style=\"padding: 12px 16px; text-align: right;\">\n                  <a href=\"https:\/\/www.google.com\/maps\/search\/Mundo+In+{{ nombre | replace: ' ', '+' }}\" \n                     target=\"_blank\" \n                     rel=\"noopener\"\n                     style=\"display: inline-flex; align-items: center; gap: 6px; background: #7EB4C1; color: white; padding: 8px 12px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 600; transition: background 0.2s;\">\n                    <i class=\"ph-bold ph-map-trifold\"><\/i> VER MAPA\n                  <\/a>\n                <\/td>\n              <\/tr>\n            {% endif %}\n          {% endfor %}\n        <\/tbody>\n      <\/table>\n    <\/div>\n  <\/div>\n  {% endif %}\n<\/div>\n\n{% comment %} \n  5. SCRIPT DE ESCUCHA (EVENT LISTENER): \n  Detecta el cambio de variante y actualiza solo el fragmento de la tabla.\n{% endcomment %}\n<script>\ndocument.addEventListener('change', function(e) {\n  \/\/ Escucha cambios en selectores de variantes comunes de Shopify\n  if (e.target && (e.target.name === 'id' || e.target.classList.contains('single-option-selector'))) {\n    setTimeout(() => {\n      const url = new URL(window.location.href);\n      const variantId = url.searchParams.get('variant');\n\n      if (variantId) {\n        \/\/ Petición fetch para traer solo el contenido actualizado de la variante seleccionada\n        fetch(`${window.location.pathname}?variant=${variantId}`)\n          .then(response => response.text())\n          .then(html => {\n            const parser = new DOMParser();\n            const doc = parser.parseFromString(html, 'text\/html');\n            const newContent = doc.querySelector('#dynamic-inventory-wrapper');\n            const oldContent = document.querySelector('#dynamic-inventory-wrapper');\n            \n            if (newContent && oldContent) {\n              oldContent.innerHTML = newContent.innerHTML;\n            }\n          })\n          .catch(error => console.error('Error al actualizar stock:', error));\n      }\n    }, 150); \/\/ Delay ligero para asegurar que Shopify actualizó la URL\n  }\n});\n<\/script>"},"blocks":{}}},"block_order":["custom_liquid_NaGmcr"]},"accordion_row_RJ3Axh":{"type":"_accordion-row","settings":{"heading":"Materiales y dimensiones","open_by_default":false,"icon":"none","width":20},"blocks":{"text_jG7Xe7":{"type":"text","settings":{"text":"<p>{{ closest.product.metafields.custom.material | metafield_tag }}<\/p><p>{{ closest.product.metafields.custom.dimensiones | metafield_tag }}<\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_jG7Xe7"]},"accordion_row_rXfr4x":{"type":"_accordion-row","settings":{"heading":"Políticas de envío y pago*","open_by_default":false,"icon":"none","width":20},"blocks":{"text_dpnw8a":{"type":"text","settings":{"text":"<p><em>***El pago contra entrega, no mayor a $5,000 pesos mexicanos, aplica en la CDMX y zona de cobertura en el Estado de México, Santiago de Querétaro, Puebla y Toluca.<\/em><\/p><p><em><br\/>***Envios en zona de cobertura en todo México. <\/em><\/p><p><em><br\/>***Zona extendida consultar costo de envío por medio de  nuestro Whatsapp.<\/em><\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,