          "shelf-material": {%- if product.metafields.shopify['shelf-material'].value.size > 0 -%}[{%- for item in product.metafields.shopify['shelf-material'].value -%}"{{ item.system.handle | default: item | escape }}"{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- else -%}"{{ product.metafields.shopify['shelf-material'].value.system.handle | default: product.metafields.shopify['shelf-material'].value | escape }}"{%- endif -%},
        {%- endif -%}
        "_end": true
      }
    }
  {%- endcapture -%}

  {%- assign clean_json = metafields_json | replace: ',"_end": true', '' | replace: ',}', '}' | replace: ', }', '}' | strip -%}
  data-product-metafields='{{ clean_json }}'
{%- endif -%}
