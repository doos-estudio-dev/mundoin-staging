{% if product.metafields.custom.video_yt %}
  <div id="product-video-container" data-video-url="{{ product.metafields.custom.video_yt }}"></div>

  <style>
    .product-video {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      max-width: 100%;
      margin: 20px 0;
    }
    
    .product-video iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
  </style>

  <script>
    (function() {
      const container = document.getElementById('product-video-container');
      const videoUrl = container.getAttribute('data-video-url');
      
      let videoId = '';

      // Extraer ID del video según el formato
      if (videoUrl.includes('youtube.com/watch?v=')) {
        videoId = videoUrl.split('v=')[1].split('&')[0];
      } else if (videoUrl.includes('youtu.be/')) {
        videoId = videoUrl.split('youtu.be/')[1].split('?')[0];
      }

      if (videoId) {
        const embedUrl = `https://www.youtube.com/embed/${videoId}`;
        
        container.innerHTML = `
          <div class="product-video">
            <iframe
              src="${embedUrl}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        `;
      }
    })();
  </script>
{% endif %}