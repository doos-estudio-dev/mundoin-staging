<div class="product-card-price-stock">
  <span class="product-card-price">
    {{ product.price | money }}
  </span>
  {% if product.available %}
    <span style="color: #10b981; font-size: 0.875rem; font-weight: 500;">En stock</span>
  {% else %}
    <span style="color: #ef4444; font-size: 0.875rem; font-weight: 500;">Agotado</span>
  {% endif %}
</div>
