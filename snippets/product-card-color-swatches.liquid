{% comment %}
  Muestra circulitos de colores para las variantes de color en product cards.

  Cada swatch es un botón que lleva los datos de su variante, de modo que al
  seleccionarlo la tarjeta cambia de variante por completo: imagen, precio,
  enlace al producto y el id enviado al carrito. La lógica vive en
  assets/product-card-swatches.js (delegación de eventos, una sola vez por página).

  Prioridad de color: swatch nativo de Shopify → PNG en Shopify Files →
  color HTML de respaldo.

  @param {object} product - El producto

  Uso: {% render 'product-card-color-swatches', product: product %}
{% endcomment %}

{%- liquid
  assign has_colors = false
  assign color_option = null

  if settings.swatches_enable
    assign swatch_trigger = settings.swatches_swatch_trigger | default: 'Color' | downcase | strip

    for option in product.options_with_values
      assign option_name_downcase = option.name | downcase | strip
      if option_name_downcase == swatch_trigger or option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'colore'
        assign color_option = option
        assign has_colors = true
        break
      endif
    endfor
  endif
-%}

{%- if has_colors and color_option.values.size > 0 -%}
  {%- liquid
    assign option_index = color_option.position | minus: 1
    assign swatch_card_size = settings.swatches_product_card_size | default: 28

    # La tarjeta muestra la imagen destacada del producto, así que el swatch
    # marcado de inicio debe ser el de la variante dueña de esa imagen.
    assign initial_variant = product.selected_or_first_available_variant
    if product.featured_media
      for variant in product.variants
        if variant.featured_media.id == product.featured_media.id
          assign initial_variant = variant
          break
        endif
      endfor
    endif
    assign initial_color = initial_variant.options[option_index]
  -%}

  <div
    class="product-card-swatches"
    data-product-id="{{ product.id }}"
    style="--product-card-swatch-size: {{ swatch_card_size }}px;"
  >
    <div class="product-card-swatches__list">
      {%- for color_value in color_option.values limit: 5 -%}
        {%- liquid
          # Preferir una variante disponible de este color; si no hay, la primera.
          assign color_variant = null
          assign fallback_variant = null

          for variant in product.variants
            if variant.options[option_index] == color_value.name
              if fallback_variant == null
                assign fallback_variant = variant
              endif
              if variant.available
                assign color_variant = variant
                break
              endif
            endif
          endfor

          if color_variant == null
            assign color_variant = fallback_variant
          endif
        -%}

        {%- if color_variant -%}
          {%- liquid
            assign variant_image = color_variant.featured_media.preview_image
            if variant_image == blank
              assign variant_image = product.featured_media.preview_image
            endif

            assign is_selected = false
            if color_value.name == initial_color
              assign is_selected = true
            endif

            assign color_name_lower = color_value.name | downcase
            assign color_hex = null
            assign color_png_url = null

            if settings.swatches_files_url and settings.swatches_files_url != blank
              assign color_file_name = color_value.name | downcase | handleize | append: '.png'
              assign color_png_url = settings.swatches_files_url | append: color_file_name
            endif

            case color_name_lower
              when 'negro', 'black'
                assign color_hex = '#000000'
              when 'blanco', 'white'
                assign color_hex = '#FFFFFF'
              when 'gris', 'gray', 'grey'
                assign color_hex = '#808080'
              when 'rojo', 'red'
                assign color_hex = '#FF0000'
              when 'azul', 'blue'
                assign color_hex = '#0000FF'
              when 'verde', 'green'
                assign color_hex = '#008000'
              when 'amarillo', 'yellow'
                assign color_hex = '#FFFF00'
              when 'naranja', 'orange'
                assign color_hex = '#FFA500'
              when 'mostaza', 'mustard'
                assign color_hex = '#FFDB58'
              when 'tabaco', 'tobacco'
                assign color_hex = '#8B6B47'
              when 'aceituna', 'olive green'
                assign color_hex = '#6B8E23'
            endcase
          -%}

          <button
            type="button"
            class="product-card-swatch{% if is_selected %} is-selected{% endif %}{% unless color_variant.available %} product-card-swatch--unavailable{% endunless %}"
            title="{{ color_value.name | escape }}"
            aria-label="{{ color_value.name | escape }}{% unless color_variant.available %} — agotado{% endunless %}"
            aria-pressed="{% if is_selected %}true{% else %}false{% endif %}"
            data-variant-id="{{ color_variant.id }}"
            data-variant-url="{{ color_variant.url }}"
            data-available="{% if color_variant.available %}true{% else %}false{% endif %}"
            data-price="{{ color_variant.price | money }}"
            {% if color_variant.compare_at_price > color_variant.price %}
              data-compare-at-price="{{ color_variant.compare_at_price | money }}"
            {% endif %}
            {% if color_variant.featured_media %}
              data-media-id="{{ color_variant.featured_media.id }}"
            {% endif %}
            {% if variant_image != blank %}
              data-image="{{ variant_image | image_url: width: 800 }}"
              data-image-srcset="{{ variant_image | image_url: width: 400 }} 400w, {{ variant_image | image_url: width: 600 }} 600w, {{ variant_image | image_url: width: 800 }} 800w, {{ variant_image | image_url: width: 1200 }} 1200w"
            {% endif %}
          >
            {%- if color_value.swatch -%}
              {% render 'swatch', swatch: color_value.swatch %}
            {%- elsif color_png_url -%}
              <span
                class="swatch swatch--unscaled"
                style="background: url({{ color_png_url }}) {{ color_hex | default: '#cccccc' }}; background-size: cover; background-position: center;"
              ></span>
            {%- elsif color_hex -%}
              <span class="swatch swatch--unscaled" style="background: {{ color_hex }};"></span>
            {%- else -%}
              <span class="swatch swatch--unscaled" style="background: {{ color_name_lower }};"></span>
            {%- endif -%}
          </button>
        {%- endif -%}
      {%- endfor -%}

      {%- if color_option.values.size > 5 -%}
        <div class="product-card-swatch product-card-swatch--more" aria-hidden="true">
          <span class="swatch-more">+{{ color_option.values.size | minus: 5 }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
