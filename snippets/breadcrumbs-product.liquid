{% comment %}
  Snippet: Breadcrumbs para página de producto

  Parámetros:
  - product: El objeto del producto
  - collection: El objeto de la colección (opcional)

  Funcionalidad:
  - Muestra la ruta COMPLETA de navegación con jerarquía
  - Soporta colecciones padre usando metafield parent_collection
  - Optimizado para SEO con Schema.org markup
  - Diseño limpio y responsive
{% endcomment %}

{%- liquid
  # Detectar la colección actual
  assign current_collection_context = null

  # Método 1: Desde parámetro URL ?collection=handle
  if request.path contains '/products/' and request.query_string contains 'collection='
    assign collection_param = request.query_string | split: 'collection=' | last | split: '&' | first
    assign current_collection_context = collections[collection_param]
  endif

  # Método 2: Si viene desde una colección (variable collection disponible)
  if collection and current_collection_context == null
    assign current_collection_context = collection
  endif

  # Método 3: Fallback - usar la primera colección del producto
  if current_collection_context == null and product.collections.size > 0
    assign current_collection_context = product.collections.first
  endif

  # Construir array de colecciones (jerarquía)
  assign breadcrumb_collections = ''
  assign position = 1

  # Si hay una colección actual, construir la jerarquía
  if current_collection_context
    assign current_collection = current_collection_context
    assign hierarchy = ''
    assign max_depth = 5
    assign depth = 0

    # Recorrer hacia arriba buscando colecciones padre
    for i in (1..max_depth)
      if current_collection and depth < max_depth
        # Agregar a la jerarquía (al inicio, porque vamos de hijo a padre)
        if hierarchy == ''
          assign hierarchy = current_collection.handle
        else
          assign hierarchy = current_collection.handle | append: ',' | append: hierarchy
        endif

        # Buscar colección padre en metafield
        if current_collection.metafields.custom.parent_collection
          assign parent_handle = current_collection.metafields.custom.parent_collection
          assign current_collection = collections[parent_handle]
          assign depth = depth | plus: 1
        else
          break
        endif
      else
        break
      endif
    endfor

    assign breadcrumb_collections = hierarchy
  endif
-%}

