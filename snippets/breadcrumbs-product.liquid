<style>
  /* Hover effects con CSS para mejor performance */
  .breadcrumbs a:hover {
    color: #000 !important;
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .breadcrumbs {
      margin: 0 !important;
    }

    .breadcrumbs ol {
      font-size: 13px !important;
      gap: 0.35rem !important;
    }

    .breadcrumbs svg {
      width: 14px !important;
      height: 14px !important;
    }

    /* Truncar texto largo en móvil */
    .breadcrumbs span[aria-current="page"] {
      max-width: 150px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: inline-block;
    }
  }

  /* Accesibilidad: Focus states */
  .breadcrumbs a:focus {
    outline: 2px solid #000;
    outline-offset: 2px;
  }
</style>
