{% comment %}
  Header Custom con Megamenu - Totalmente configurable desde el personalizador de Shopify
{% endcomment %}

<style>
  :root {
    --teal-dark: {{ section.settings.color_teal_dark }};
    --teal: {{ section.settings.color_teal }};
    --teal-light: {{ section.settings.color_teal_light }};
    --text-main: {{ section.settings.color_text_main }};
    --text-muted: {{ section.settings.color_text_muted }};
    --bg-body: {{ section.settings.color_bg_body }};
  }

  header.custom-header-megamenu {
    position: relative;
    z-index: 1000;
    background: #fff;
    border-bottom: 1px solid rgba(15, 82, 89, 0.12);
    box-shadow: 0 6px 16px -12px rgba(15, 82, 89, 0.65);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  header.custom-header-megamenu.scrolled {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
  }

  header.custom-header-megamenu.scrolled .top-bar {
    display: none !important;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
  }

  header.custom-header-megamenu.scrolled .top-bar.custom-content {
    display: none !important;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
  }

  header.custom-header-megamenu.scrolled .header-wrapper {
    padding: 0.75rem 1.5rem 0.5rem !important;
  }

  header.custom-header-megamenu.scrolled .brand img {
    width: min(220px, 100%) !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .top-bar {
    background: var(--teal-dark);
    color: #fff;
    font-size: 0.9rem;
    padding: 0.65rem 0;
    transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                padding 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .top-bar .content {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: center;
  }

  .top-bar.custom-content {
    padding: 0;
  }

  .top-bar.custom-content .content {
    padding: 0 !important;
    max-width: 100%;
  }

  .top-bar a {
    color: inherit;
    text-decoration: none;
  }

  .header-wrapper {
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.75rem 1.5rem 0.75rem;
    position: relative;
  }

  .header-main {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    grid-template-areas: "brand search actions";
    align-items: center;
    column-gap: 1.5rem;
  }

  .menu-toggle {
    grid-area: menu;
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--teal);
    border-radius: 2px;
    content: "";
  }

  .menu-toggle span {
    position: relative;
  }

  .menu-toggle span::before {
    position: absolute;
    top: -5px;
  }

  .menu-toggle span::after {
    position: absolute;
    top: 5px;
  }

  .search {
    grid-area: search;
    display: flex;
    justify-content: flex-start;
  }

  .search-field {
    position: relative;
    width: 100%;
  }

  .search-field input {
    width: 100%;
    padding: 0.7rem 2.7rem 0.7rem 1.2rem;
    border-radius: 999px;
    border: 1.5px solid var(--teal);
    outline: none;
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .search-field input::placeholder {
    color: var(--text-muted);
    opacity: 0.3;
  }

  .search-field svg {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    stroke: var(--teal);
    cursor: pointer;
  }

  .search-field__label {
    display: block;
  }

  .predictive-search {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    background: #fff;
    border: 1px solid rgba(15, 82, 89, 0.18);
    border-radius: 16px;
    box-shadow: 0 24px 50px -28px rgba(15, 82, 89, 0.55);
    padding: 1.2rem;
    z-index: 1200;
    max-height: 420px;
    overflow-y: auto;
    display: none;
  }

  .predictive-search[data-open="true"] {
    display: block;
  }

  .predictive-search__inner {
    display: grid;
    gap: 1.25rem;
  }

  .predictive-search__section[hidden],
  .predictive-search__empty[hidden] {
    display: none !important;
  }

  .predictive-search__heading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.6rem;
  }

  .predictive-search__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .predictive-search__item {
    display: flex;
  }

  .predictive-search__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    text-decoration: none;
    color: var(--text-main);
    transition: color 0.2s ease;
  }

  .predictive-search__link:hover,
  .predictive-search__link:focus {
    color: var(--teal-dark);
  }

  .predictive-search__thumb {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(46, 111, 117, 0.08);
    display: grid;
    place-items: center;
    font-weight: 600;
    color: var(--teal);
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .predictive-search__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .predictive-search__thumb--placeholder {
    background: rgba(46, 111, 117, 0.1);
  }

  .predictive-search__title {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .predictive-search__empty {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Autocompletado de sugerencias */
  .predictive-search__autocomplete {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding-bottom: 12px;
    margin-bottom: 12px;
  }

  .predictive-search__suggestions {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .predictive-search__suggestion {
    padding: 8px 12px;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.2s;
    font-size: 0.9rem;
    color: #333;
    display: flex;
    align-items: center;
  }

  .predictive-search__suggestion:hover,
  .predictive-search__suggestion.active {
    background-color: #f5f5f5;
  }

  .predictive-search__suggestion svg {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    opacity: 0.5;
  }

  /* Botón Ver todos los resultados */
  .predictive-search__view-all {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding-top: 12px;
    margin-top: 8px;
  }

  .predictive-search__view-all-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 16px;
    background-color: #145b5d;
    color: #ffffff;
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .predictive-search__view-all-link:hover {
    background-color: #0f4647;
    transform: translateY(-1px);
    color: #ffffff;
  }

  .predictive-search__view-all-link:active {
    transform: translateY(0);
  }

  @media (max-width: 960px) {
    .predictive-search {
      position: fixed;
      left: 50%;
      top: 190px;
      transform: translateX(-50%);
      width: min(94vw, 520px);
      max-height: calc(100vh - 140px);
      padding: 1rem;
    }
  }

  .brand {
    grid-area: brand;
    display: flex;
    justify-content: flex-start;
  }

  .brand img {
    width: min(258px, 100%);
    height: auto;
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .actions {
    grid-area: actions;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  .actions a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 500;
  }

  .actions-icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .actions-icons svg {
    width: 22px;
    height: 22px;
    stroke: var(--teal);
    stroke-width: 1.7;
    fill: none;
  }

  nav.custom-nav-megamenu {
    max-width: 1440px;
    margin: 0.35rem auto 1.5rem;
    padding: 0 1.5rem 0.5rem;
  }

  .nav-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .nav-menu > li {
    position: relative;
  }

  .navmenu-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .navmenu-link:hover {
    color: var(--teal-dark);
  }

  summary.navmenu-link {
    list-style: none;
  }

  summary.navmenu-link::-webkit-details-marker {
    display: none;
  }

  details[data-navmenu-details] {
    position: relative;
  }

  .navmenu-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .navmenu-icon svg {
    width: 8px;
    height: 6px;
    stroke: currentColor;
  }

  .nav-menu-link--sale {
    background: var(--teal-light);
    color: #fff;
    padding: 0.55rem 1.3rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .nav-menu-link--sale .navmenu-icon svg {
    stroke: #fff;
  }

  .navmenu-link-depth-2,
  .navmenu-link-depth-3 {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-main);
    white-space: nowrap;
  }

  .navmenu-submenu {
    list-style: none;
    margin: 0;
    padding: 0.85rem 1.1rem;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 18px 38px -24px rgba(15, 82, 89, 0.65);
    display: none;
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 220px;
    z-index: 1000;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .navmenu-submenu > li + li {
    margin-top: 0.65rem;
  }

  .navmenu-depth-2 > li {
    position: relative;
  }

  .navmenu-depth-2 > li > details > summary {
    padding-right: 1rem;
    padding-bottom: 0;
    padding-top: 0;
  }

  .navmenu-depth-2 > li > details > summary .navmenu-icon svg {
    transform: rotate(-90deg);
  }

  .navmenu-depth-2 .navmenu-submenu {
    top: 0;
    left: calc(100% + 0.6rem);
    transform: none;
    z-index: 1001;
  }

  /* Asegurar que el tercer nivel también sea visible */
  .navmenu-depth-3.navmenu-submenu {
    top: 0;
    left: calc(100% + 0.6rem);
    transform: none;
    z-index: 1002;
    background: #fff;
    box-shadow: 0 18px 38px -24px rgba(15, 82, 89, 0.65);
  }

  details[open] > .navmenu-submenu {
    display: block !important;
  }

  /* Ajustes especiales de posicionamiento para menús específicos */
  .navmenu-id-promociones .navmenu-submenu {
    left: 75% !important;
  }

  .navmenu-id-clientes .navmenu-submenu {
    left: -50% !important;
  }

  @media (min-width: 961px) {
    .navmenu-submenu {
      opacity: 0;
      visibility: hidden;
    }

    details[open] > .navmenu-submenu {
      opacity: 1;
      visibility: visible;
      display: block !important;
    }
  }

  @media (max-width: 960px) {
    header.custom-header-megamenu nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header-wrapper {
      padding: 1.25rem 0 0.75rem;
      transition: padding 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    header.custom-header-megamenu.scrolled .header-wrapper {
      padding: 0.75rem 0 0.5rem !important;
    }

    header.custom-header-megamenu.scrolled .brand img {
      width: min(100px, 100%) !important;
    }

    /* Hide search when scrolling down on mobile */
    .search {
      transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                  padding 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                  margin 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    header.custom-header-megamenu.hide-search .search {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      padding: 0;
      margin: 0;
    }

    header.custom-header-megamenu.hide-search .header-main {
      row-gap: 0;
    }

    .header-main {
      transition: row-gap 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .brand {
      grid-area: brand;
      text-align: center;
    }

    .brand img {
      width: min(115px, 100%);
      height: auto;
      display: block;
      margin: 0 auto;
      transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .header-main {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        "menu brand actions"
        "search search search";
      padding: 0 1.25rem;
      column-gap: 0.75rem;
      row-gap: 1rem;
      align-items: center;
      justify-items: center;
    }

    .menu-toggle {
      display: flex;
      justify-self: start;
      grid-area: menu;
    }

    .actions {
      justify-self: end;
      grid-area: actions;
    }

    .search {
      grid-area: search;
      justify-content: center;
      width: 100%;
    }

    .search-field {
      max-width: none;
      width: 90%;
      margin-inline: auto;
    }

    .search-field input {
      padding: 0.8rem 2.75rem 0.8rem 1.1rem;
    }

    .actions {
      justify-content: flex-end;
      gap: 0.75rem;
    }

    /* Ocultar solo el enlace de texto "Sucursales", no los iconos */
    .actions > a {
      display: none;
    }

    .actions-icons {
      display: flex !important;
      gap: 0.75rem;
      align-items: center;
    }

    .actions-icons a {
      display: flex !important;
      align-items: center;
      justify-content: center;
    }

    .actions-icons .icon-user {
      display: none !important;
    }

    .actions-icons svg {
      width: 26px;
      height: 26px;
      display: block !important;
    }
  }

  body.sidebar-open {
    overflow: hidden;
  }

  .mobile-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(90vw, 340px);
    background: var(--bg-body);
    z-index: 2000;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    display: flex;
    flex-direction: column;
  }

  .mobile-sidebar[data-open="true"] {
    transform: translateX(0);
  }

  .mobile-sidebar__header {
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(15, 82, 89, 0.1);
  }

  .mobile-sidebar__close {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: var(--teal);
  }

  .mobile-sidebar__body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 1rem 0;
  }

  .mobile-sidebar__body nav {
    display: block;
    margin: 0;
    padding: 0;
  }

  .mobile-sidebar__body .nav-menu {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0 1.25rem;
  }

  .mobile-sidebar__body .navmenu-link {
    padding: 0.8rem 0;
    width: 100%;
    display: flex;
    justify-content: flex-start;
  }

  .mobile-sidebar__body .nav-menu-link--sale {
    border-radius: 0;
    background: none;
    color: var(--teal-dark);
    font-weight: 600;
    padding: 0.8rem 0;
  }

  .mobile-sidebar__body .nav-menu-link--sale .navmenu-icon svg {
    stroke: var(--teal-dark);
  }

  .mobile-sidebar__body .navmenu-submenu {
    position: static;
    display: block;
    transform: none;
    box-shadow: none;
    border: none;
    border-radius: 0;
    padding: 0.5rem 0 0.5rem 1.25rem;
    min-width: auto;
    margin-top: -0.5rem;
  }

  .mobile-sidebar__body .navmenu-submenu {
    display: none;
  }

  details[open] > .navmenu-submenu {
    display: block;
  }

  .mobile-sidebar__body .navmenu-depth-2 .navmenu-submenu {
    left: 0;
    padding-left: 2.25rem;
  }

  .mobile-sidebar__body .navmenu-depth-2 > li > details > summary .navmenu-icon svg {
    transform: rotate(0deg);
  }

  .mobile-sidebar__body .navmenu-depth-2 > li > details[open] > summary .navmenu-icon svg {
    transform: rotate(180deg);
  }

  .mobile-sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 82, 89, 0.4);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .mobile-sidebar-overlay[data-open="true"] {
    opacity: 1;
    visibility: visible;
  }
</style>

<header class="custom-header-megamenu">
  {% if section.settings.show_top_bar %}
  <div class="top-bar">
    <div class="content">
      <span>{{ section.settings.top_bar_text }}
        {% if section.settings.top_bar_phone != blank %}
          <a href="tel:{{ section.settings.top_bar_phone }}">{{ section.settings.top_bar_phone }}</a>
        {% endif %}
      </span>
    </div>
  </div>
  {% else %}
    {% if section.settings.custom_top_bar_code != blank %}
    <div class="top-bar custom-content">
      <div class="content">
        {{ section.settings.custom_top_bar_code }}
      </div>
    </div>
    {% endif %}
  {% endif %}

  <div class="header-wrapper">
    <div class="header-main">
      <button class="menu-toggle" type="button" aria-label="Abrir menú">
        <span></span>
      </button>

      <div class="brand">
        <a href="/">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 516 }}"
                 alt="{{ shop.name }}"
                 width="{{ section.settings.logo_width }}"
                 loading="lazy">
          {% else %}
            <img src="https://mundoin.mx/cdn/shop/files/Frame_2_258x48.png?v=1754349509" alt="{{ shop.name }}">
          {% endif %}
        </a>
      </div>

      <div class="actions">
      {% if section.settings.show_sucursales_link %}
        <a href="{{ section.settings.sucursales_link }}">{{ section.settings.sucursales_text }}</a>
      {% endif %}

      <div class="actions-icons">
        {% if section.settings.show_account_icon %}
        <a href="/account/login">
          <svg class="icon-user" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="7.5" r="3.5" />
            <path d="M5 20c0-3.2 3.1-5.8 7-5.8s7 2.6 7 5.8" />
          </svg>
        </a>
        {% endif %}

        {% if section.settings.show_cart_icon %}
          {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
            {% render 'cart-drawer' %}
          {% else %}
            <a href="/cart">
              <svg class="icon-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M6.5 6h15l-1.4 8.2c-0.2 1.1-1.1 1.8-2.2 1.8H9.6c-1.1 0-2-0.8-2.2-1.8L6 4H3" stroke-linecap="round" />
                <circle cx="10" cy="20" r="1.3" fill="currentColor" stroke="none" />
                <circle cx="18" cy="20" r="1.3" fill="currentColor" stroke="none" />
              </svg>
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_search %}
    <div class="search">
      <div class="search-field" data-search-field>
        <label class="search-field__label" for="site-search-{{ section.id }}">
          <span class="sr-only">Buscar</span>
          <input id="site-search-{{ section.id }}"
                 type="search"
                 placeholder="{{ section.settings.search_placeholder }}"
                 autocomplete="on">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8" />
            <line x1="16.65" y1="16.65" x2="21" y2="21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </label>

        <div class="predictive-search"
             id="predictive-search-results-{{ section.id }}"
             data-predictive-search
             hidden
             role="dialog"
             aria-label="Resultados de búsqueda"
             aria-modal="false">
          <div class="predictive-search__inner">
            <!-- Sugerencias de autocompletado -->
            <div class="predictive-search__autocomplete" data-autocomplete-suggestions hidden>
