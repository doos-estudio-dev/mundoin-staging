{% comment %} ---- SECCIÓN DEL BANNER CARRUSEL ---- {% endcomment %}
  <style>
    #home-{{ section.id }} .slide-desktop {
      height: {{ section.settings.desktop_height }}px;
      background-color: {{ section.settings.desktop_bg_color }};
      overflow: hidden;
    }
    #home-{{ section.id }} .slide-desktop img,
    #home-{{ section.id }} .slide-desktop picture {
      display: block;
      width: 100%;
      height: 100%;
    }
    #home-{{ section.id }} .slide-desktop img {
      object-fit: {{ section.settings.desktop_fit }};
      object-position: center;
    }
    #home-{{ section.id }} .slide-mobile {
      height: {{ section.settings.mobile_height }}px;
      background-color: {{ section.settings.mobile_bg_color }};
      overflow: hidden;
    }
    #home-{{ section.id }} .slide-mobile img {
      width: 100%;
      height: 100%;
      object-fit: {{ section.settings.mobile_fit }};
      object-position: center;
    }
    {% if section.settings.unified_carousel %}
      #home-{{ section.id }} .banner-deskt { display: block !important; }
      #home-{{ section.id }} .bannr-movil  { display: none  !important; }
    {% endif %}
    @media (max-width: 768px) {
      #home-{{ section.id }} .slide-desktop.slide-has-mobile img {
        object-fit: contain !important;
        object-position: center !important;
      }
    }
  </style>

  <section class="new-banner" id="home-{{ section.id }}">
    <div class="banner-deskt carousel-wrapper">
      <div class="element-banner-deskt">
        {% assign first_desktop_slide = true %}
        {% for block in section.blocks %}
          {% if block.type == 'desktop_slide' and block.settings.image != blank %}
            {% assign alt_d = block.settings.alt_text | default: 'Banner desktop' %}
            {% assign loading_attr = 'lazy' %}
            {% assign fetch_attr = 'auto' %}
            {% if first_desktop_slide %}
              {% assign loading_attr = 'eager' %}
              {% assign fetch_attr = 'high' %}
              {% assign first_desktop_slide = false %}
            {% endif %}
            {% assign slide_fit = block.settings.slide_fit | default: '' %}
            {% if slide_fit == blank %}{% assign slide_fit = section.settings.desktop_fit %}{% endif %}
            {% assign slide_pos = block.settings.slide_position | default: 'center' %}
            {% assign img_style = 'object-fit: ' | append: slide_fit | append: '; object-position: ' | append: slide_pos | append: '; width: 100%; height: 100%;' %}
            {% assign has_mobile_img = false %}
            {% if block.settings.image_mobile != blank %}{% assign has_mobile_img = true %}{% endif %}
            <a class="slide-desktop{% if has_mobile_img %} slide-has-mobile{% endif %}"
              href="{{ block.settings.link | default: '#' }}"
              {% if block.settings.slide_height > 0 %}style="height: {{ block.settings.slide_height }}px;"{% endif %}
              {{ block.shopify_attributes }}>
              {% if has_mobile_img %}
                {% capture mobile_srcset %}{{ block.settings.image_mobile | image_url: width: 375 }} 375w, {{ block.settings.image_mobile | image_url: width: 550 }} 550w, {{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 828 }} 828w{% endcapture %}
                <picture>
                  <source media="(max-width: 768px)" srcset="{{ mobile_srcset }}" sizes="100vw">
                  {{
                    block.settings.image
                    | image_url: width: 2400
                    | image_tag: alt: alt_d, loading: loading_attr, fetchpriority: fetch_attr, decoding: 'async', widths: '750, 1100, 1500, 1780, 2000, 2400', sizes: '100vw', style: img_style
                  }}
                </picture>
              {% else %}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag: alt: alt_d, loading: loading_attr, fetchpriority: fetch_attr, decoding: 'async', widths: '375, 750, 1100, 1500, 1780, 2000, 2400', sizes: '(max-width: 768px) 1px, 100vw', style: img_style
                }}
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
      <button type="button" class="carousel-button prev" aria-label="Anterior">&#10094;</button>
      <button type="button" class="carousel-button next" aria-label="Siguiente">&#10095;</button>
    </div>

    <div class="bannr-movil carousel-wrapper">
      <div class="element-banner-movil">
        {% assign first_mobile_slide = true %}
        {% for block in section.blocks %}
          {% if block.type == 'mobile_slide' and block.settings.image_m != blank %}
            {% assign alt_m = block.settings.alt_text_m | default: 'Banner mobile' %}
            {% assign loading_attr = 'lazy' %}
            {% assign fetch_attr = 'auto' %}
            {% if first_mobile_slide %}
              {% assign loading_attr = 'eager' %}
              {% assign fetch_attr = 'high' %}
              {% assign first_mobile_slide = false %}
            {% endif %}
            <a class="slide-mobile" href="{{ block.settings.link_m | default: '#' }}" {{ block.shopify_attributes }}>
              {{
                block.settings.image_m
                | image_url: width: 800
                | image_tag: alt: alt_m, loading: loading_attr, fetchpriority: fetch_attr, decoding: 'async', widths: '375, 550, 750, 800', sizes: '(min-width: 769px) 1px, 100vw'
              }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
      <button type="button" class="carousel-button prev" aria-label="Anterior">&#10094;</button>
      <button type="button" class="carousel-button next" aria-label="Siguiente">&#10095;</button>
    </div>
  </section>

  <script>
    (function() {
      const section = document.getElementById('home-{{ section.id }}');
      if (!section) return;

      const initCarousel = (wrapper) => {
        if (!wrapper) return;

        const carousel = wrapper.querySelector('.element-banner-deskt, .element-banner-movil');
        const prevButton = wrapper.querySelector('.carousel-button.prev');
        const nextButton = wrapper.querySelector('.carousel-button.next');

        if (!carousel || !prevButton || !nextButton) return;

        // Evitar inicialización duplicada
        if (wrapper.dataset.carouselInitialized) return;
        wrapper.dataset.carouselInitialized = 'true';

        const slides = carousel.querySelectorAll('a');
        if (slides.length === 0) return;

        const totalSlides = slides.length;
        let currentIndex = 0;

        const scrollToSlide = (index) => {
          const slideWidth = slides[0].clientWidth + (parseFloat(getComputedStyle(carousel).gap) || 0);
          carousel.scrollTo({ left: slideWidth * index, behavior: 'smooth' });
        };

        nextButton.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          currentIndex++;
          if (currentIndex >= totalSlides) {
            currentIndex = 0;
          }
          scrollToSlide(currentIndex);
        });

        prevButton.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          currentIndex--;
          if (currentIndex < 0) {
            currentIndex = totalSlides - 1;
          }
          scrollToSlide(currentIndex);
        });
      };

      // Inicializar ambos carruseles
      const desktopWrapper = section.querySelector('.banner-deskt');
      const mobileWrapper = section.querySelector('.bannr-movil');

      initCarousel(desktopWrapper);
      initCarousel(mobileWrapper);
    })();
  </script>

  {% comment %} ---- INICIO DEL CONTENIDO DINÁMICO ---- {% endcomment %}
  {%- if section.settings.faq_title != blank -%}
    <div class="page-width">
      <h2 class="faq-section-title">{{ section.settings.faq_title | escape }}</h2>
    </div>
  {%- endif -%}

  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'text_content' %}
        <div class="page-width">
          <div class="custom-content-wrapper">
            <div class="text-content-block" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                {% if block.settings.use_h1 %}
                  <h1>{{ block.settings.heading | escape }}</h1>
                {% else %}
                  <h2>{{ block.settings.heading | escape }}</h2>
                {% endif %}
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}
              {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                <a href="{{ block.settings.button_link }}" class="button">
                  {{ block.settings.button_label | escape }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>

      {% when 'collection_item' %}
        {%- assign prev_index = forloop.index0 | minus: 1 -%}
        {%- assign prev_block = section.blocks[prev_index] -%}
        {%- if forloop.first or prev_block.type != 'collection_item' -%}
          <div class="page-width">
            <div class="collections-grid">
        {%- endif -%}

        <div class="collection-item" {{ block.shopify_attributes }}>
          {%- assign collection = block.settings.collection -%}
          {%- assign image = block.settings.image -%}
          {%- comment -%} Eliminar texto antes de | si existe {%- endcomment -%}
          {%- assign display_title = block.settings.title | default: collection.title | default: 'Nombre de la Colección' -%}
          {%- if display_title contains '|' -%}
            {%- assign title_parts = display_title | split: '|' -%}
            {%- assign display_title = title_parts[1] | strip -%}
          {%- endif -%}
          <a href="{{ collection.url | default: '#' }}" target="" rel="noopener" class="collection-link">
            <h3 class="collection-item-title">{{ display_title }}</h3>
            <div class="collection-image-wrapper">
              {% if image != blank %}
                {{ image | image_url: width: 500 | image_tag: alt: image.alt, loading: 'lazy', sizes: '(max-width: 768px) 50vw, 25vw' }}
              {% elsif collection.image != blank %}
                {{ collection.image | image_url: width: 500 | image_tag: alt: collection.title, loading: 'lazy', sizes: '(max-width: 768px) 50vw, 25vw' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
          </a>
        </div>

        {%- assign next_block = section.blocks[forloop.index] -%}
        {%- if forloop.last or next_block.type != 'collection_item' -%}
            </div>
          </div>
        {%- endif -%}

      {% when 'circular_collection_item' %}
        {%- assign prev_index = forloop.index0 | minus: 1 -%}
        {%- assign prev_block = section.blocks[prev_index] -%}
        {%- if forloop.first or prev_block.type != 'circular_collection_item' -%}
          <div class="page-width">
            <div class="circular-collections-grid">
        {%- endif -%}

        <div class="circular-collection-item" {{ block.shopify_attributes }}>
          {%- assign collection = block.settings.collection -%}
          {%- assign image = block.settings.image -%}

          {%- comment -%} Calcular el menor precio de la colección (optimizado) {%- endcomment -%}
          {%- assign min_price = 999999999 -%}
          {%- if collection != blank -%}
            {%- for product in collection.products limit: 10 -%}
              {%- if product.available and product.price < min_price -%}
                {%- assign min_price = product.price -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} Eliminar texto antes de | si existe {%- endcomment -%}
          {%- assign circular_display_title = block.settings.title | default: collection.title | default: 'Nombre' -%}
          {%- if circular_display_title contains '|' -%}
            {%- assign title_parts = circular_display_title | split: '|' -%}
            {%- assign circular_display_title = title_parts[1] | strip -%}
          {%- endif -%}

          <a href="{{ collection.url | default: '#' }}" target="" rel="noopener" class="collection-link">
            <div class="circular-collection-image-wrapper">
              {% if image != blank %}
                {{ image | image_url: width: 400 | image_tag: alt: image.alt, loading: 'lazy', sizes: '(max-width: 768px) 50vw, 20vw' }}
              {% elsif collection.image != blank %}
                {{ collection.image | image_url: width: 400 | image_tag: alt: collection.title, loading: 'lazy', sizes: '(max-width: 768px) 50vw, 20vw' }}
              {% else %}
                {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <h3 class="circular-collection-item-title">{{ circular_display_title }}</h3>

            {%- if block.settings.subtitle != blank -%}
              <p class="circular-collection-item-subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="circular-collection-item-description">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if collection != blank and min_price < 999999999 -%}
              <p class="circular-collection-item-price">Desde <span style="color:red; font-size:20px">{{ min_price | money }}</span></p>
            {%- endif -%}
          </a>
        </div>

        {%- assign next_block = section.blocks[forloop.index] -%}
        {%- if forloop.last or next_block.type != 'circular_collection_item' -%}
            </div>
          </div>
        {%- endif -%}

      {% when 'faq_item' %}
        {%- assign prev_index = forloop.index0 | minus: 1 -%}
        {%- assign prev_block = section.blocks[prev_index] -%}
        {%- if forloop.first or prev_block.type != 'faq_item' -%}
          <div class="page-width">
            <div class="faq-wrapper">
        {%- endif -%}

        <div class="faq-item" {{ block.shopify_attributes }}>
          <h3>
            <button class="faq-question" aria-expanded="false">
              <span class="faq-question-text">{{ block.settings.question | escape }}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="faq-answer" hidden>
            <div class="rte">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>

        {%- assign next_block = section.blocks[forloop.index] -%}
        {%- if forloop.last or next_block.type != 'faq_item' -%}
            </div>
          </div>
        {%- endif -%}

      {% when 'multicolumn' %}
        {% render 'multicolumna', settings: block.settings %}

    {% endcase %}
  {% endfor %}
  {% comment %} ---- FIN DEL CONTENIDO DINÁMICO ---- {% endcomment %}

{% schema %}
{
  "name": "Home",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Banner Desktop"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Altura (px)",
      "min": 200,
      "max": 900,
      "step": 10,
      "default": 550
    },
    {
      "type": "select",
      "id": "desktop_fit",
      "label": "Ajuste de imagen",
      "options": [
        { "value": "cover", "label": "Rellenar (puede recortar)" },
        { "value": "contain", "label": "Contener (sin recorte)" }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "desktop_bg_color",
      "label": "Color de fondo desktop",
      "default": "#f5f5f5",
      "info": "Visible solo cuando el ajuste es 'Contener'"
    },
    {
      "type": "header",
      "content": "Banner Mobile"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Altura (px)",
      "min": 150,
      "max": 700,
      "step": 10,
      "default": 400
    },
    {
      "type": "select",
      "id": "mobile_fit",
      "label": "Ajuste de imagen",
      "options": [
        { "value": "contain", "label": "Contener (sin recorte)" },
        { "value": "cover", "label": "Rellenar (puede recortar)" }
      ],
      "default": "contain"
    },
    {
      "type": "color",
      "id": "mobile_bg_color",
      "label": "Color de fondo mobile",
      "default": "#ffffff",
      "info": "Visible cuando el ajuste es 'Contener'"
    },
    {
      "type": "header",
      "content": "Responsive"
    },
    {
      "type": "checkbox",
      "id": "unified_carousel",
      "label": "Carrusel unificado (desktop + móvil)",
      "default": false,
      "info": "Activa cuando cada Desktop slide tenga su propia imagen móvil. Oculta el carrusel móvil separado y muestra el desktop en todas las pantallas."
    },
    {
      "type": "header",
      "content": "FAQ"
    },
    {
      "type": "text",
      "id": "faq_title",
      "label": "Título sección FAQ"
    }
  ],
  "blocks": [
    {
      "type": "desktop_slide",
      "name": "Desktop slide",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (desktop)" },
        { "type": "text", "id": "alt_text", "label": "Texto ALT", "default": "Banner desktop" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" },
        { "type": "header", "content": "Tamaño de imagen" },
        {
          "type": "range",
          "id": "slide_height",
          "label": "Altura personalizada (px)",
          "min": 0,
          "max": 900,
          "step": 10,
          "default": 0,
          "info": "0 = usar la altura definida en la sección"
        },
        {
          "type": "select",
          "id": "slide_fit",
          "label": "Ajuste de imagen",
          "options": [
            { "value": "", "label": "Usar configuración de sección" },
            { "value": "cover", "label": "Rellenar (puede recortar)" },
            { "value": "contain", "label": "Contener (sin recorte)" }
          ],
          "default": ""
        },
        {
          "type": "select",
          "id": "slide_position",
          "label": "Posición de imagen",
          "options": [
            { "value": "center", "label": "Centro" },
            { "value": "top center", "label": "Arriba" },
            { "value": "bottom center", "label": "Abajo" },
            { "value": "left center", "label": "Izquierda" },
            { "value": "right center", "label": "Derecha" }
          ],
          "default": "center"
        },
        { "type": "header", "content": "Imagen móvil" },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen para móvil (opcional)",
          "info": "Se muestra en pantallas ≤768px sin recorte. Activa 'Carrusel unificado' en la sección para que este carrusel también sea visible en móvil."
        }
      ]
    },
    {
      "type": "mobile_slide",
      "name": "Mobile slide",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image_m", "label": "Imagen (mobile)" },
        { "type": "text", "id": "alt_text_m", "label": "Texto ALT", "default": "Banner mobile" },
        { "type": "url", "id": "link_m", "label": "Enlace (opcional)" }
      ]
    },
    {
      "type": "heading",
      "name": "Título de Sección",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título de la Sección"
        }
      ]
    },
    {
      "type": "text_content",
      "name": "Contenido de Texto",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Habla sobre tu marca"
        },
        {
          "type": "checkbox",
          "id": "use_h1",
          "label": "Usar H1 en lugar de H2",
          "default": false,
          "info": "Activa esta opción para que el título sea un H1 (importante para SEO)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Usa este texto para compartir información sobre tu marca con tus clientes.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Etiqueta del botón",
          "default": "Botón"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        }
      ]
    },
    {
      "type": "collection_item",
      "name": "Colección Cuadrada",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Seleccionar Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen Personalizada (Opcional)",
          "info": "Si no se selecciona ninguna, se usará la imagen de la colección."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Texto del Título",
          "info": "Si se deja en blanco, se usará el nombre de la colección."
        }
      ]
    },
    {
      "type": "circular_collection_item",
      "name": "Colección Circular",
      "limit": 10,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Seleccionar Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen Personalizada (Opcional)",
          "info": "Si no se selecciona ninguna, se usará la imagen de la colección."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Texto del Título",
          "info": "Si se deja en blanco, se usará el nombre de la colección."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "Pregunta Frecuente",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cuál es la pregunta?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Añade la respuesta a la pregunta aquí.</p>"
        }
      ]
    },
    {
      "type": "multicolumn",
      "name": "Multicolumna",
      "settings": [
        {
          "type": "header",
          "content": "Configuración General"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título principal"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtítulo"
        },
        {
          "type": "header",
          "content": "Columna 1"
        },
        {
          "type": "image_picker",
          "id": "col1_icon",
          "label": "Icono 1"
        },
        {
          "type": "text",
          "id": "col1_title",
          "label": "Título 1",
          "default": "Envío Gratis"
        },
        {
          "type": "richtext",
          "id": "col1_text",
          "label": "Texto 1",
          "default": "<p>En compras mayores a $500</p>"
        },
        {
          "type": "header",
          "content": "Columna 2"
        },
        {
          "type": "image_picker",
          "id": "col2_icon",
          "label": "Icono 2"
        },
        {
          "type": "text",
          "id": "col2_title",
          "label": "Título 2",
          "default": "Pago Seguro"
        },
        {
          "type": "richtext",
          "id": "col2_text",
          "label": "Texto 2",
          "default": "<p>Protegemos tu información</p>"
        },
        {
          "type": "header",
          "content": "Columna 3"
        },
        {
          "type": "image_picker",
          "id": "col3_icon",
          "label": "Icono 3"
        },
        {
          "type": "text",
          "id": "col3_title",
          "label": "Título 3",
          "default": "Soporte 24/7"
        },
        {
          "type": "richtext",
          "id": "col3_text",
          "label": "Texto 3",
          "default": "<p>Estamos para ayudarte</p>"
        },
        {
          "type": "header",
