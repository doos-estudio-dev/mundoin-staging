<div class="text-slider-section section-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="text-slider__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="text-slider__container" id="Slider-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="text-slider__slide" {{ block.shopify_attributes }} id="Slide-{{ section.id }}-{{ forloop.index }}">
          <div class="text-slider__card">
            <h3 class="text-slider__title">{{ block.settings.title }}</h3>
            <p class="text-slider__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="text-slider__pagination mobile-only">
        {% for block in section.blocks %}
          <button class="text-slider__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .text-slider-section {
    padding: 40px 0;
    background-color: {{ section.settings.bg_color }};
  }
  .text-slider__heading {
    text-align: center;
    margin-bottom: 30px;
    color: #2c454e; 
  }
  .text-slider__card {
    background: #ffffff;
    padding: 24px;
    border-radius: 8px;
    height: 100%;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  .text-slider__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #2c454e; 
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .text-slider__text {
    font-size: 0.95rem;
    color: #555555;
    line-height: 1.5;
    margin: 0;
  }

  /* Desktop Layout: 2x2 Grid */
  @media screen and (min-width: 769px) {
    .text-slider__container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
    .mobile-only {
      display: none !important;
    }
  }

  /* Mobile Layout: Scroll Snap Slider */
  @media screen and (max-width: 768px) {
    .text-slider__container {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      gap: 15px;
      padding-bottom: 20px;
    }
    /* Hide scrollbar for clean UX */
    .text-slider__container::-webkit-scrollbar {
      display: none;
    }
    .text-slider__container {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .text-slider__slide {
      flex: 0 0 90%;
      scroll-snap-align: center;
    }
    .text-slider__pagination {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 10px;
    }
    .text-slider__dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #cbd5e1;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }
    .text-slider__dot.is-active {
      background-color: #2c454e;
      transform: scale(1.2);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('Slider-{{ section.id }}');
    const dots = document.querySelectorAll('.text-slider-section.section-{{ section.id }} .text-slider__dot');

    if (!slider || dots.length === 0) return;

    // Update dots on scroll using Intersection Observer for max performance
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = Array.from(slider.children).indexOf(entry.target);
          dots.forEach(dot => dot.classList.remove('is-active'));
          if(dots[index]) dots[index].classList.add('is-active');
        }
      });
    }, {
      root: slider,
      threshold: 0.6 // Trigger when 60% of the slide is visible
    });

    Array.from(slider.children).forEach(slide => observer.observe(slide));

    // Allow clicking dots to scroll to slide
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const slide = slider.children[index];
        slide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Text Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Promociones Exclusivas"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9fafb"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Block",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hasta 50% OFF + 6 MSI"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Renueva tu espacio con nuestros muebles de alta calidad."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Slider",
      "blocks": [
        { "type": "text_block" },
        { "type": "text_block" },
        { "type": "text_block" },
        { "type": "text_block" }
      ]
    }
  ]
}
{% endschema %}