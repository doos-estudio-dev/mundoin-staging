    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Logo del footer"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Título de redes sociales",
      "default": "Síguenos"
    },
    {
      "type": "header",
      "content": "Columna de Navegación"
    },
    {
      "type": "checkbox",
      "id": "show_navigation_column",
      "label": "Mostrar columna de navegación",
      "default": true
    },
    {
      "type": "text",
      "id": "navigation_title",
      "label": "Título de navegación",
      "default": "Navegación"
    },
    {
      "type": "header",
      "content": "Columna de Más Información"
    },
    {
      "type": "checkbox",
      "id": "show_info_column",
      "label": "Mostrar columna de más información",
      "default": true
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Título de más información",
      "default": "Más Información"
    },
    {
      "type": "header",
      "content": "Columna de Contacto"
    },
    {
      "type": "checkbox",
      "id": "show_contact_column",
      "label": "Mostrar columna de contacto",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Título de contacto",
      "default": "Contáctanos"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Teléfono",
      "default": "Atención al cliente 55 4192 9961"
    },
    {
      "type": "text",
      "id": "contact_hours_weekday",
      "label": "Horario entre semana",
      "default": "Lunes a Viernes 10:00 am a 07:00 pm"
    },
    {
      "type": "text",
      "id": "contact_hours_saturday",
      "label": "Horario sábado",
      "default": "Sábados 10:00 am a 04:00 pm"
    },
    {
      "type": "header",
      "content": "Footer Inferior"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_links",
      "label": "Mostrar enlaces inferiores",
      "default": true
    },
    {
      "type": "textarea",
      "id": "copyright_text",
      "label": "Texto de copyright",
      "default": "Propiedad artística © 2025 MUNDO IN. &nbsp;|&nbsp; Tecnología de Shopify"
    },
    {
      "type": "header",
      "content": "Íconos de Métodos de Pago"
    },
    {
      "type": "paragraph",
      "content": "Se muestran automáticamente los métodos de pago activados en tu tienda (Configuración → Pagos)."
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Red Social",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "html",
          "id": "icon",
          "label": "SVG del ícono",
          "info": "Pega el código SVG completo aquí"
        }
      ]
    },
    {
      "type": "navigation_link",
      "name": "Enlace de Navegación",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "Enlace"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    },
    {
      "type": "info_link",
      "name": "Enlace de Información",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "Enlace"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "checkbox",
          "id": "target_blank",
          "label": "Abrir en nueva pestaña",
          "default": false
        }
      ]
    },
    {
      "type": "bottom_link",
      "name": "Enlace Inferior",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "Enlace"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Custom"
    }
  ]
