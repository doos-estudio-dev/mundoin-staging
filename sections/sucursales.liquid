<div class="twl-hidden" id="info-sucursal-container">
  <div class="twl-flex twl-justify-center twl-py-1">
    <h2
      class="twl-bg-slate-900 twl-px-3 twl-py-1 twl-rounded-lg twl-text-white twl-font-bold twl-text-2xl"
      id="name-sucursal" style="color: #fff !important; background: rgb(239 117 103) !important;"
    >
      Testing
    </h2>
  </div>

  <div class="twl-flex twl-justify-center">
    <div
      class="twl-max-w-[1250px] twl-grid twl-grid-cols-1 lg:twl-grid-cols-5 twl-w-full twl-min-h-3"
    >
      <div
        class="twl-px-4 twl-flex twl-flex-col lg:twl-col-span-2 twl-gap-y-2 twl-justify-center"
      >
        <p><b>Dirección:</b> <span id="sucursal-direccion"></span></p>
        <p><b>Horario:</b> <span id="sucursal-horario"></span></p>
        <p><b>Contacto:</b> <span id="sucursal-contacto"></span></p>
        <div id="tour-container" style="display: none;" class="twl-flex twl-justify-center twl-m-4">
          <div style="width: fit-content;" class="twl-flex twl-bg-primary twl-px-3 twl-py-1 twl-rounded-xl">
            <a id="tour-link" target="_blank" style="text-decoration: none;" href="#" class="twl-text-xl twl-font-bold twl-text-white">Ver recorrido 3D</a>
          </div>
        </div>
      </div>
      <div
        class="twl-m-4 lg:twl-col-span-3 twl-max-h-72 twl-rounded-xl"
        id="sucursal-map"
      ></div>
    </div>
  </div>

  <div class="twl-flex twl-justify-center">
    <div
      class="twl-max-w-[1250px] twl-flex twl-items-center twl-justify-center twl-w-full twl-min-h-3"
    >
      <fieldset>
        <label
          class="no-border"
          id="label-1"
          style="
            --_img: url(https://cdn.shopify.com/s/files/1/1233/2374/files/MUNDOIN_PATTERN01_1.png?v=1668748705);
          "
        >
          <input class="no-border" type="radio" name="images" value="Fiddle Leaf" />
        </label>
        <label
          class="no-border"
          id="label-2"
          style="
            --_img: url(https://cdn.shopify.com/s/files/1/1233/2374/files/MUNDOIN_PATTERN01_1.png?v=1668748705);
          "
        >
          <input class="no-border" type="radio" name="images" value="Pink Princess" />
        </label>
        <label
          class="no-border"
          id="label-3"
          style="
            --_img: url(https://cdn.shopify.com/s/files/1/1233/2374/files/MUNDOIN_PATTERN01_1.png?v=1668748705);
          "
        >
          <input class="no-border" type="radio" name="images" value="Monstera" checked />
        </label>
      </fieldset>
    </div>
  </div>
</div>
</div>

