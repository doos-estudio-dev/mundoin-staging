{% liquid
  assign section_title = section.settings.section_title
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    collection-circles-section
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
  "
>
  {% if section_title != blank %}
    <div class="collection-circles__heading">
      <h2 class="collection-circles__title {{ section.settings.heading_size }}">
        {{ section_title }}
      </h2>
    </div>
  {% endif %}

  <div class="collection-circles__wrapper">
    <div class="collection-circles__grid">
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign custom_image = block.settings.custom_image
          assign custom_title = block.settings.custom_title

          # Determinar la imagen a usar
          if custom_image != blank
            assign collection_image = custom_image
          elsif collection != blank and collection.image != blank
            assign collection_image = collection.image
          elsif collection != blank and collection.products.first.featured_image != blank
            assign collection_image = collection.products.first.featured_image
          else
            assign collection_image = blank
          endif

          # Determinar el título a usar
          if custom_title != blank
            assign display_title = custom_title
          elsif collection != blank
            assign display_title = collection.title
          else
            assign display_title = 'Collection'
          endif

          # Determinar el enlace
          if collection != blank
            assign collection_url = collection.url
          else
            assign collection_url = '#'
          endif
        %}

        <div class="collection-circles__item" {{ block.shopify_attributes }}>
          <a href="{{ collection_url }}" class="collection-circles__link">
            <div class="collection-circles__image-wrapper">
              {% if collection_image != blank %}
                <img
                  src="{{ collection_image | image_url: width: 360 }}"
                  srcset="
                    {{ collection_image | image_url: width: 180 }} 180w,
                    {{ collection_image | image_url: width: 360 }} 360w
                  "
                  sizes="(min-width: 750px) 180px, 150px"
                  alt="{{ display_title | escape }}"
                  loading="lazy"
                  width="180"
                  height="180"
                  class="collection-circles__image"
                >
              {% else %}
                <div class="collection-circles__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>

            <div class="collection-circles__title-wrapper">
              <span class="collection-circles__collection-title">
                {{ display_title }}
              </span>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-circles-section {
    padding: 2rem 1.5rem;
  }

  .collection-circles__heading {
    text-align: center;
    margin-bottom: 2rem;
  }

  .collection-circles__title {
    margin: 0;
  }

  .collection-circles__wrapper {
    width: 100%;
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
  }

  .collection-circles__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin: 0 auto;
  }

  .collection-circles__item {
    flex: 0 0 auto;
    max-width: 180px;
    width: 100%;
  }

  /* Responsive: móviles pequeños - 2 por fila */
  @media (max-width: 480px) {
    .collection-circles__item {
      max-width: calc(50% - 1rem);
    }
  }

  /* Tablets - 3 por fila */
  @media (min-width: 481px) and (max-width: 768px) {
    .collection-circles__item {
      max-width: 180px;
    }
  }

  /* Desktop - máximo 6 por fila */
  @media (min-width: 769px) {
    .collection-circles__grid {
      max-width: calc(180px * 6 + 2rem * 5); /* 6 items + gaps */
    }
  }

  .collection-circles__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .collection-circles__link:hover {
    transform: translateY(-5px);
  }

  .collection-circles__image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%; /* Aspect ratio 1:1 */
    overflow: hidden;
    border-radius: 50%;
    background-color: rgba(var(--color-foreground), 0.04);
    margin-bottom: 1rem;
  }

  .collection-circles__image,
  .collection-circles__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-circles__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-circles__placeholder svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .collection-circles__title-wrapper {
    text-align: center;
    width: 100%;
  }

  .collection-circles__collection-title {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    word-wrap: break-word;
  }

  .collection-circles__link:hover .collection-circles__collection-title {
    text-decoration: underline;
  }

  /* Efecto hover en la imagen */
  .collection-circles__image-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0);
    transition: background-color 0.3s ease;
  }

  .collection-circles__link:hover .collection-circles__image-wrapper::after {
    background-color: rgba(0, 0, 0, 0.1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Colecciones Circulares",
  "tag": "section",
  "class": "collection-circles",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Título de la sección",
      "default": "Nuestras Colecciones"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        {
          "value": "h3",
          "label": "Pequeño"
        },
        {
          "value": "h2",
          "label": "Mediano"
        },
        {
          "value": "h1",
          "label": "Grande"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de la sección",
      "options": [
        {
          "value": "full",
          "label": "Ancho completo"
        },
        {
          "value": "default",
          "label": "Predeterminado"
        },
        {
          "value": "narrow",
          "label": "Estrecho"
        }
      ],
      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "limit": 12,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Imagen personalizada",
          "info": "Si se deja vacío, se usará la imagen de la colección"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Título personalizado",
          "info": "Si se deja vacío, se usará el título de la colección"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones Circulares",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
