          "custom_top_bar_code": "<div class=\"msj-hot-sale\">\n  <label>\n    ¡Aprovecha solo hoy el Cyber Monday! Cotizaciones al +52 5527856135 </label>\n    <p style=\"margin: 0; color:#000;\" id=\"contador-hot-sale\"></p>\n  \n</div>\n<style>\n  .msj-hot-sale {\n    /* display: none !important; */\n    width: 100%;\n    margin-inline: auto;\n    text-align: center;\n    align-content: center;\n    background: #4c0b75;\n    padding: 5px 0;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 15px;\n}\n  .msj-hot-sale > label {\n    font-weight: bold;\n    padding: 0.8rem 1.5rem;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    cursor: pointer;\n    color: #000;\n    background: #fff;\n    border-radius: 25px;\n    height: fit-content;\n}\n  .count-values {\n    display: flex;\n    gap: 1rem;\n}\n  .count-values > div > div {\n    background: red;\n    border-radius: 3px;\n    padding: 2px;\nfont-size: 12px;\nfont-weight:bold;\n    background:#fff;\n}\n  .count-values > div {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n}\n  @media (max-width: 650px){\n    .msj-hot-sale{\n      flex-direction: column;\n    }\n    p#contador-hot-sale{\n      margin:0;\n    }\n    .msj-hot-sale > label{\n      font-size: 2.5vw;\n    }\n  }\n</style>\n<script>\n  // FECHA DE FINALIZACIÓN DEL SALE (Ajusta aquí: Año, Mes (0-11), Día, Hora, Minuto, Segundo)\n  const fechaFin = new Date(2025, 11, 01, 23, 59, 59); // 1 diciembre 2025, 23:59:59\n  \n  function actualizarContador() {\n    const ahora = new Date().getTime();\n    const diferencia = fechaFin.getTime() - ahora;\n    \n    if (diferencia > 0) {\n      // Calculamos las horas totales (incluyendo los días convertidos a horas)\n      const horasTotales = Math.floor(diferencia / (1000 * 60 * 60));\n      const minutos = Math.floor((diferencia % (1000 * 60 * 60)) / (1000 * 60));\n      const segundos = Math.floor((diferencia % (1000 * 60)) / 1000);\n      \n      document.getElementById(\"contador-hot-sale\").innerHTML =\n  `<div class=\"count-values\">\n    <div class=\"container-element\">\n      <div class=\"container-value\">\n        ${horasTotales.toString().padStart(2, \"0\")}\n      </div>\n      <div class=\"container-value\" style=\"font-size: 10px;\">\n        H\n      </div>\n    </div>\n    <div class=\"container-element\">\n      <div class=\"container-value\">\n        ${minutos.toString().padStart(2, \"0\")}\n      </div>\n      <div class=\"container-value\" style=\"font-size: 10px;\">\n        M\n      </div>\n    </div>\n    <div class=\"container-element\">\n      <div class=\"container-value\">\n        ${segundos.toString().padStart(2, \"0\")}\n      </div>\n      <div class=\"container-value\" style=\"font-size: 10px;\">\n        S\n      </div>\n    </div>\n  </div>`;\n    } else {\n      document.getElementById(\"contador-hot-sale\").textContent = \"¡Finalizó!\";\n    }\n  }\n  \n  // Actualiza cada segundo\n  setInterval(actualizarContador, 1000);\n  actualizarContador();\n</script>",
